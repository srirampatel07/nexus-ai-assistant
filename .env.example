# NEXUS environment template — copy to .env and fill in values.
# Never commit real credentials.

# App
APP_NAME=NEXUS
ENVIRONMENT=development
LOG_LEVEL=INFO

# AI provider abstraction (Phase 1: echo works offline; openai needs key+url)
AI_PROVIDER=echo
AI_MODEL=nexus-default
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30

# Example: Groq via the generic OpenAI-compatible provider (working config).
# Copy these values into .env and replace the key placeholder with your own.
# AI_PROVIDER=openai-compatible
# AI_MODEL=openai/gpt-oss-120b
# AI_API_KEY=your-groq-api-key
# AI_BASE_URL=https://api.groq.com/openai/v1

# Example: local Qwen3-8B via llama.cpp (llama-server.exe, no hosted API).
# Start the server first (see docs/LOCAL.md), then copy these values into
# .env. AI_API_KEY stays empty: local mode sends no Bearer credential.
# AI_MODEL must be the exact id from GET http://127.0.0.1:8080/v1/models.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://127.0.0.1:8080/v1
# AI_MODEL=C:\Users\shash\.cache\huggingface\hub\models--Qwen--Qwen3-8B-GGUF\snapshots\7c41481f57cb95916b40956ab2f0b139b296d974\Qwen3-8B-Q4_K_M.gguf
# AI_API_KEY=

# Conversation
MAX_HISTORY_MESSAGES=20
TEXT_MODE_DEBUG=false

# Persistent memory (Phase 3, local SQLite — no secrets here)
MEMORY_ENABLED=true
MEMORY_DATABASE_PATH=data/nexus.db
MEMORY_CONTEXT_LIMIT=10
MEMORY_CONTEXT_MAX_CHARS=4000
MEMORY_RECENT_LIMIT=10
MEMORY_DEFAULT_CATEGORY=conversation
MEMORY_RETENTION_DAYS=0

# Voice interface (Phase 4, all local — no secrets here)
VOICE_ENABLED=true
VOICE_STT_BACKEND=vosk
VOICE_TTS_BACKEND=sapi
VOICE_STT_MODEL_PATH=data/vosk-model-small-en-us-0.15
VOICE_SAMPLE_RATE=16000
VOICE_CHANNELS=1
VOICE_LANGUAGE=en-US
VOICE_SILENCE_TIMEOUT_SECONDS=1.2
VOICE_MAX_UTTERANCE_SECONDS=15
VOICE_TTS_RATE=175
VOICE_TTS_VOLUME=1.0
VOICE_STOP_PHRASES=stop listening,goodbye nexus,exit voice

# Vision interface (Phase 5 — local file input only, no screenshots/camera)
# Chat model (AI_MODEL) never receives images; image analysis uses
# VISION_MODEL only. Hosted mode reuses VISION_API_KEY or AI_API_KEY.
# VISION_BASE_URL overrides the endpoint independently; empty reuses AI_BASE_URL.
VISION_ENABLED=true
VISION_PROVIDER=openai-compatible
VISION_MODEL=openrouter/free
VISION_BASE_URL=
VISION_API_KEY=
# When true (default), /vision hands the vision report to the text model
# for a synthesized final answer (sequential model handoff via the
# launcher when needed). When false, /vision shows the vision report
# directly without any text-model call.
VISION_TEXT_SYNTHESIS=true
VISION_MAX_BYTES=10485760
VISION_MAX_DIM=2048
VISION_JPEG_QUALITY=85

# Example: fully local vision (Qwen2.5-VL-3B on llama-server :8081).
# VISION_PROVIDER=local refuses any non-loopback endpoint, sends no
# credential, and never falls back to a hosted provider. Start the vision
# server first (see docs/LOCAL.md), then copy these values into .env.
# VISION_ENABLED=true
# VISION_PROVIDER=local
# VISION_BASE_URL=http://127.0.0.1:8081/v1
# VISION_MODEL=qwen2.5-vl-3b-local
# VISION_API_KEY=

# Web + browser (Phase 6 — search, page retrieval, reader sessions)
# Default search is keyless (DuckDuckGo HTML results, real result links).
# A legacy Instant Answer JSON endpoint (https://api.duckduckgo.com/)
# still parses when configured. No secrets here.
WEB_ENABLED=true
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_URL=https://html.duckduckgo.com/html/
WEB_SEARCH_TIMEOUT=15
WEB_SEARCH_MAX_RESULTS=8
WEB_FETCH_TIMEOUT=20
WEB_FETCH_MAX_BYTES=1048576
WEB_FETCH_MAX_REDIRECTS=5
WEB_TEXT_MAX_CHARS=20000
