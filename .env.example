# NEXUS environment template — copy to .env and fill in values.
# Never commit real credentials.

# App
APP_NAME=NEXUS
ENVIRONMENT=development
LOG_LEVEL=INFO

# AI provider abstraction (Phase 1: echo works offline; openai needs key+url)
AI_PROVIDER=echo
AI_MODEL=nexus-default
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30

# Example: Groq via the generic OpenAI-compatible provider (working config).
# Copy these values into .env and replace the key placeholder with your own.
# AI_PROVIDER=openai-compatible
# AI_MODEL=openai/gpt-oss-120b
# AI_API_KEY=your-groq-api-key
# AI_BASE_URL=https://api.groq.com/openai/v1

# Conversation
MAX_HISTORY_MESSAGES=20
TEXT_MODE_DEBUG=false
