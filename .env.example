# NEXUS environment template — copy to .env and fill in values.
# Never commit real credentials.

# App
APP_NAME=NEXUS
ENVIRONMENT=development
LOG_LEVEL=INFO

# AI provider: NVIDIA is the single cloud AI provider. `echo` is an
# offline non-AI stub for tests/development (it repeats input; no
# inference, no network, no key needed).
AI_PROVIDER=echo
AI_MODEL=nexus-default
AI_API_KEY=
AI_BASE_URL=
# Request timeout (seconds) for NVIDIA chat/vision HTTP calls. Define once:
# within-file duplicates resolve last-wins via python-dotenv, and the OS
# environment overrides .env. If the provider is slow, a timeout reports
# honest provider unavailability — it is not retried or hidden.
AI_TIMEOUT_SECONDS=30

# Example: NVIDIA cloud (text + vision). This is the normal NEXUS
# configuration: all AI inference uses the hosted NVIDIA API. Text uses
# Nemotron 3.5 Lightning; vision uses the separate vision-capable
# meta/llama-3.2-11b-vision-instruct model (the text model cannot take
# images). Set NVIDIA_API_KEY, then copy these values into .env. No local
# model servers, no loopback ports, no model files required. No free-quota
# promise: rate limits and quota errors are reported honestly, never
# silently retried on another provider.
# AI_PROVIDER=nvidia
# NVIDIA_API_KEY=your-nvidia-api-key-here
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
# (Verified live HTTP 200. The previous default nemotron-nano-12b-v2-vl was
# retired 2026-08-26 — remove any line pinning it; the resolver ignores
# retired IDs and uses the current default above.)
# AI_TIMEOUT_SECONDS=30
# (No other AI providers are configured. Local model operation was
# removed; legacy Groq/local examples were deleted.)

# Conversation
MAX_HISTORY_MESSAGES=20
TEXT_MODE_DEBUG=false

# Agent orchestration (Phase 7 — bounded multi-step tool use, no secrets)
# MAX_TOOL_ITERATIONS caps model turns that may request tools per reply.
# TOOL_LOOP_TIMEOUT_SECONDS caps overall wall-clock time per reply (first
# model turn always runs). TOOL_RESULT_MAX_CHARS caps one tool result fed
# back into model context (excess is cut with a truncation marker).
MAX_TOOL_ITERATIONS=3
TOOL_LOOP_TIMEOUT_SECONDS=300
TOOL_RESULT_MAX_CHARS=20000

# Persistent memory (Phase 3, local SQLite — no secrets here)
MEMORY_ENABLED=true
MEMORY_DATABASE_PATH=data/nexus.db
MEMORY_CONTEXT_LIMIT=10
MEMORY_CONTEXT_MAX_CHARS=4000
MEMORY_RECENT_LIMIT=10
MEMORY_DEFAULT_CATEGORY=conversation
MEMORY_RETENTION_DAYS=0

# Voice (Phase 8: NVIDIA cloud speech; no local AI models, no secrets here)
# Live microphone speech-to-text uses verified NVIDIA cloud Parakeet ASR
# (nvidia/parakeet-ctc-1_1b-asr, English) via NVCF HTTPS. Microphone audio
# is captured only in live voice mode, encoded to WAV in memory, sent to
# NVIDIA for transcription, then dropped (never stored/logged). The same
# NVIDIA_API_KEY used for chat also authenticates speech (nvapi-...).
# Spoken output defaults to the local Windows OS synthesizer (SAPI, an OS
# utility, not NVIDIA); VOICE_TTS_BACKEND=nvidia selects verified NVIDIA
# cloud Magpie TTS instead (reply text sent to NVIDIA, WAV played locally).
VOICE_ENABLED=true
VOICE_STT_BACKEND=nvidia
VOICE_TTS_BACKEND=sapi
VOICE_SAMPLE_RATE=16000
VOICE_CHANNELS=1
VOICE_SILENCE_TIMEOUT_SECONDS=1.2
VOICE_MAX_UTTERANCE_SECONDS=15
VOICE_TTS_RATE=175
VOICE_TTS_VOLUME=1.0
VOICE_STOP_PHRASES=stop listening,goodbye nexus,exit voice
# NVIDIA speech endpoints (verified live Oct 2026; function IDs are public
# routing identifiers, not secrets — override only if NVIDIA publishes new IDs)
# STT: POST {base}/v1/audio/transcriptions (multipart file=WAV + language)
NVIDIA_STT_FUNCTION_ID=1598d209-5e27-4d3c-8079-4751568b1081
NVIDIA_STT_BASE_URL=
VOICE_STT_LANGUAGE=en-US
VOICE_STT_TIMEOUT_SECONDS=30
# TTS: POST {base}/v1/audio/synthesize (multipart text+language+voice)
NVIDIA_TTS_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969
NVIDIA_TTS_BASE_URL=
VOICE_TTS_LANGUAGE=en-US
VOICE_TTS_VOICE=Magpie-Multilingual.EN-US.Aria
VOICE_TTS_SAMPLE_RATE_HZ=44100
VOICE_TTS_TIMEOUT_SECONDS=30

# Vision interface (NVIDIA cloud — local file input, cloud inference)
# Image analysis always uses a vision-capable model (never the text-only
# AI_MODEL) through an OpenAI-compatible chat endpoint with image_url
# content. With AI_PROVIDER=nvidia, vision uses NVIDIA_VISION_MODEL on the
# shared NVIDIA base URL + API key; loopback URLs / GGUF ids left over
# from legacy configs are ignored, never contacted. VISION_MODEL /
# VISION_BASE_URL / VISION_API_KEY override only when explicitly set to
# hosted values.
VISION_ENABLED=true
VISION_PROVIDER=nvidia
VISION_MODEL=
VISION_BASE_URL=
VISION_API_KEY=
# When true (default), /vision hands the vision report to the NVIDIA text
# model for a synthesized final answer. When false, /vision shows the
# vision report directly without any text-model call. When the text
# provider is unreachable, the vision report is shown directly with an
# honest notice — never routed to another provider.
VISION_TEXT_SYNTHESIS=true
VISION_MAX_BYTES=10485760
VISION_MAX_DIM=2048
VISION_JPEG_QUALITY=85

# (Local vision was removed: VISION_PROVIDER=local now raises an explicit
# error telling the user to use NVIDIA cloud.)

# Web + browser (Phase 6 — search, page retrieval, reader sessions)
# Default search is keyless (DuckDuckGo HTML results, real result links).
# A legacy Instant Answer JSON endpoint (https://api.duckduckgo.com/)
# still parses when configured. No secrets here.
WEB_ENABLED=true
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_URL=https://html.duckduckgo.com/html/
WEB_SEARCH_TIMEOUT=15
WEB_SEARCH_MAX_RESULTS=8
WEB_FETCH_TIMEOUT=20
WEB_FETCH_MAX_BYTES=1048576
WEB_FETCH_MAX_REDIRECTS=5
WEB_TEXT_MAX_CHARS=20000
