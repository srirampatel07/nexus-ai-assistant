# NEXUS environment template — copy to .env and fill in values.
# Never commit real credentials.

# App
APP_NAME=NEXUS
ENVIRONMENT=development
LOG_LEVEL=INFO

# AI provider abstraction (Phase 1: echo works offline; openai needs key+url)
AI_PROVIDER=echo
AI_MODEL=nexus-default
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30

# Example: Groq via the generic OpenAI-compatible provider (working config).
# Copy these values into .env and replace the key placeholder with your own.
# AI_PROVIDER=openai-compatible
# AI_MODEL=openai/gpt-oss-120b
# AI_API_KEY=your-groq-api-key
# AI_BASE_URL=https://api.groq.com/openai/v1

# Conversation
MAX_HISTORY_MESSAGES=20
TEXT_MODE_DEBUG=false

# Persistent memory (Phase 3, local SQLite — no secrets here)
MEMORY_ENABLED=true
MEMORY_DATABASE_PATH=data/nexus.db
MEMORY_CONTEXT_LIMIT=10
MEMORY_CONTEXT_MAX_CHARS=4000
MEMORY_RECENT_LIMIT=10
MEMORY_DEFAULT_CATEGORY=conversation
MEMORY_RETENTION_DAYS=0

# Voice interface (Phase 4, all local — no secrets here)
VOICE_ENABLED=true
VOICE_STT_BACKEND=vosk
VOICE_TTS_BACKEND=sapi
VOICE_STT_MODEL_PATH=data/vosk-model-small-en-us-0.15
VOICE_SAMPLE_RATE=16000
VOICE_CHANNELS=1
VOICE_LANGUAGE=en-US
VOICE_SILENCE_TIMEOUT_SECONDS=1.2
VOICE_MAX_UTTERANCE_SECONDS=15
VOICE_TTS_RATE=175
VOICE_TTS_VOLUME=1.0
VOICE_STOP_PHRASES=stop listening,goodbye nexus,exit voice

# Vision interface (Phase 5 — local file input only, no screenshots/camera)
# Text model (AI_MODEL) stays text-only; image analysis uses VISION_MODEL
# via the same AI_BASE_URL + AI_API_KEY (no second provider).
VISION_ENABLED=true
VISION_MODEL=qwen/qwen3.8-27b
VISION_MAX_BYTES=10485760
VISION_MAX_DIM=2048
VISION_JPEG_QUALITY=85
